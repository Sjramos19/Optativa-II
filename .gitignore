# ==============================================================================
# .gitignore — TechStore ERP (Código Fuente Funcional)
# ==============================================================================

# Entregables y documentos académicos del Momento 3 (NO subir a GitHub)
ENTREGA_MOMENTO_3*
GUIA_GRABACION_Y_SUSTENTACION*
capturas/
*.pdf

# Archivos de base de datos SQLite y temporales de ejecución
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
*.db
*.sqlite
*.sqlite3

# Python Cache y Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Entornos virtuales
venv/
.venv/
env/
.env

# Editores y Sistema Operativo
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

SUBIR_A_GITHUB.bat
